    <!-- JavaScript Slider and Modal Logic -->
    <script>
        // Hero Slider Data
        const slides = [
            {
                title: "روروني كينشين - فصل هوكايدو",
                desc: "يعود كينشين هيمورا في فصل جديد مليء بالإثارة، حيث يواجه ماضياً مظلماً في شمال اليابان. هل سيظل السيف مغموراً بالدماء؟",
                image: "https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&q=80&w=1200",
                badge: "أنمي الموسم",
                rating: "9.3"
            },
            {
                title: "هجوم العملاقة - الموسم الأخير",
                desc: "ملحمة البشرية ضد العمالقة تصل إلى ذروتها الكبرى. معارك ضارية ومصير غامض ينتظر إيرين ييغر وأصدقائه.",
                image: "https://images.unsplash.com/photo-1541562232579-512a21360020?auto=format&fit=crop&q=80&w=1200",
                badge: "الأعلى تقييماً",
                rating: "9.5"
            },
            {
                title: "سولو ليفلينغ - الموسم الثاني",
                desc: "سونغ جين وو يعود بقوة أكبر ليقود نقابته ويخوض أقبية ومحاربين جدد في رحلة لتجاوز حدود القوة البشرية.",
                image: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&q=80&w=1200",
                badge: "جديد الآن",
                rating: "9.1"
            },
            {
                title: "قاتل الشياطين - قصر الأبدي",
                desc: "تانجيرو وأعضاء الهاشيرا يستعدون للمعركة الحاسمة ضد كيباتسوجي موزان في قصر الشياطين المظلم.",
                image: "https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&q=80&w=1200",
                badge: "حصري",
                rating: "9.2"
            }
        ];

        let currentSlide = 0;
        const heroTitle = document.getElementById('heroTitle');
        const heroDesc = document.getElementById('heroDesc');
        const heroImage = document.getElementById('heroImage');
        const heroBadge = document.getElementById('heroBadge');
        const heroRating = document.getElementById('heroRating');
        const slideDots = document.getElementById('slideDots').children;

        function updateSlide(index) {
            currentSlide = index;
            const slide = slides[currentSlide];
            
            heroImage.style.opacity = '0.5';
            setTimeout(() => {
                heroTitle.textContent = slide.title;
                heroDesc.textContent = slide.desc;
                heroImage.src = slide.image;
                heroBadge.textContent = slide.badge;
                heroRating.textContent = slide.rating;
                heroImage.style.opacity = '1';
            }, 150);

            for (let i = 0; i < slideDots.length; i++) {
                if (i === currentSlide) {
                    slideDots[i].className = "w-8 h-2 rounded-full bg-animeRed cursor-pointer transition-all";
                } else {
                    slideDots[i].className = "w-2 h-2 rounded-full bg-gray-600 hover:bg-gray-400 cursor-pointer transition-all";
                }
            }
        }

        function nextSlide() {
            currentSlide = (currentSlide + 1) % slides.length;
            updateSlide(currentSlide);
        }

        function prevSlide() {
            currentSlide = (currentSlide - 1 + slides.length) % slides.length;
            updateSlide(currentSlide);
        }

        function setSlide(index) {
            updateSlide(index);
        }

        setInterval(nextSlide, 6000);

        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        function openWatchModal(title = 'روروني كينشين - فصل هوكايدو') {
            document.getElementById('modalAnimeTitle').textContent = title;
            const modal = document.getElementById('watchModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeWatchModal() {
            const modal = document.getElementById('watchModal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }

        function openDetailsModal() {
            showNotificationModal('عرض تفاصيل الأنمي وقائمة الحلقات الكاملة.');
        }

        function showNotificationModal(text) {
            document.getElementById('notificationText').textContent = text;
            const modal = document.getElementById('notificationModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeNotificationModal() {
            const modal = document.getElementById('notificationModal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }
    </script>
